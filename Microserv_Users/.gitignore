# ============================================
# SECRETS Y ARCHIVOS SENSIBLES
# ============================================

# Docker Compose secrets
.env
.env.*
!.env.example
*.env
!.env.example

# Kubernetes secrets
**/secrets/*.env
**/secrets/*.yaml
**/secrets/*.yml
**/overlays/*/secrets/*.env
**/overlays/*/secret.yaml
k8s/overlays/*/secrets/*.env
!k8s/overlays/*/secrets/README.md
!k8s/overlays/*/secrets/.gitkeep

# Archivos de secretos en general
*.secret
*.secret.yaml
*.secret.yml
*secret.env

# ============================================
# MICROSERVICIOS
# ============================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.jar
*.war

# Logs
logs/
*.log

# ============================================
# IDE Y SISTEMA OPERATIVO
# ============================================

# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ / WebStorm
.idea/
*.iml

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini